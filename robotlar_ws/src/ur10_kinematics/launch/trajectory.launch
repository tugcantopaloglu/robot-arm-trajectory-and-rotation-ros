<launch>
  <arg name="x0" default="0.7" />
  <arg name="y0" default="0.7" />
  <arg name="z0" default="0.7" />
  <arg name="x1" default="0.1" />
  <arg name="y1" default="0.1" />
  <arg name="z1" default="0.1" />
  <include file="$(find gazebo_plugins_rtg)/launch/ur10.launch" />

  <node pkg="ur10_kinematics" type="ur10_trajectory_node" name="ur10_trajectory_node"
    output="screen" args="$(arg x0) $(arg y0) $(arg z0) $(arg x1) $(arg y1) $(arg z1)"
    launch-prefix="bash -c 'sleep 5; $0 $@'" />
</launch>
